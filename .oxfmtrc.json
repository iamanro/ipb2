{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  // `.agents/` is vendored as-is: skills-lock.json pins each file's hash.
  "ignorePatterns": [
    "dist/**",
    "dist.next/**",
    "modules/*/data/**",
    "modules/*/state/**",
    "node_modules/**",
    ".agents/**"
  ]
}
