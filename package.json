{
  "name": "ipb",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch dev.ts",
    "dev:lan": "IPB_AUTH=on IPB_HOST=:: bun --watch dev.ts",
    "build": "bun build.ts",
    "start": "bun server/index.ts",
    "start:lan": "IPB_AUTH=on IPB_HOST=:: bun server/index.ts",
    "test": "bun test",
    "test:e2e": "bun --bun playwright test",
    "format": "bun --bun oxfmt",
    "lint": "bun --bun oxlint --type-aware && bun --bun oxfmt --check",
    "verify": "bun check && bun run lint"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@mapbox/vector-tile": "^3.0.0",
    "mgrs": "^2.2.0",
    "milsymbol": "^3.0.4",
    "ol": "^10.10.0",
    "ol-pmtiles": "^2.0.2",
    "pbf": "^5.1.2",
    "pmtiles": "^4.5.0",
    "polygon-clipping": "^0.15.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bun": "1.4.3",
    "@types/node": "24.19.1",
    "geotiff": "^3.1.0-beta.0",
    "mapshaper": "^0.7.67",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "packageManager": "bun@1.4.3"
}
